{
  "name": "faxios-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @gcmdev/faxios build",
    "test": "pnpm --filter @faxios/tests test",
    "test:vitest": "pnpm --filter @faxios/tests test:vitest",
    "test:vitest:unit": "pnpm --filter @faxios/tests test:vitest:unit",
    "test:vitest:browser": "pnpm --filter @faxios/tests test:vitest:browser",
    "test:vitest:browser:headless": "pnpm --filter @faxios/tests test:vitest:browser:headless",
    "test:vitest:watch": "pnpm --filter @faxios/tests test:vitest:watch",
    "lint": "pnpm -r --if-present lint",
    "check": "pnpm run lint && pnpm run lint:knip && pnpm --filter @faxios/tests exec ./run-tests.sh && pnpm run test:docs-examples && pnpm run size",
    "start": "pnpm --filter @faxios/sandbox start",
    "examples": "pnpm --filter @faxios/examples start",
    "lint:knip": "knip",
    "lint:ts": "pnpm -r --no-bail --if-present lint:ts",
    "lint:esl": "pnpm -r --no-bail lint:esl",
    "lint:s": "pnpm -r --no-bail lint:s",
    "lint:fix": "pnpm -r --no-bail --if-present lint:fix",
    "lint:jscpd": "jscpd .",
    "lint:e18e": "pnpm dlx @e18e/cli analyze",
    "test:docs-examples": "pnpm --filter @faxios/tests test:docs-examples",
    "size": "pnpm --filter @gcmdev/faxios size",
    "bump": "bumpy add",
    "bump:status": "bumpy status"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@gingacodemonkey/config": "^0.1.0",
    "@tanstack/intent": "0.5.3",
    "@types/node": "^24.19.0",
    "@varlock/bumpy": "1.18.1",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "jscpd": "^5.0.12",
    "knip": "6.26.0",
    "lint-staged": "^17.6.0",
    "typescript": "^6.0.3",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.5"
}
