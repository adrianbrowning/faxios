# CODEOWNERS
#
# Reviewers required for matching paths. Last-match-wins.
# Keep path-scoped rules below the catch-all so sensitive paths override it.
#
# Single-maintainer caveat: with only one owner, path-scoped rules cannot
# enforce a distinct second reviewer. They still (a) surface sensitive-path
# changes explicitly in the review UI, and (b) pre-stage scoped ownership
# for when additional maintainers are added.

# Default owner
*                            @adrianbrowning

# Runtime source — shipped to every consumer
/packages/lib/src/           @adrianbrowning

# Published manifest and build config (zshy reads packages/lib/package.json)
/packages/lib/package.json   @adrianbrowning

# Workspace, lockfile, and install hardening
/package.json                @adrianbrowning
/pnpm-lock.yaml              @adrianbrowning
/pnpm-workspace.yaml         @adrianbrowning
/.npmrc                      @adrianbrowning
/.husky/                     @adrianbrowning

# CI and repo automation
/.github/workflows/          @adrianbrowning
/.github/CODEOWNERS          @adrianbrowning
/.github/dependabot.yml      @adrianbrowning

# Security-critical docs
/THREATMODEL.md              @adrianbrowning
/SECURITY.md                 @adrianbrowning
