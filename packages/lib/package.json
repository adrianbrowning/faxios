{
  "name": "@gcmdev/faxios",
  "version": "0.1.0",
  "description": "Promise based, web-standard fetch HTTP client for the browser, Node.js, Deno and Bun",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/adrianbrowning/faxios.git"
  },
  "keywords": [
    "fetch",
    "ajax",
    "promise",
    "browser",
    "rest",
    "api",
    "client"
  ],
  "author": "Adrian Elton-Browning",
  "contributors": [
    "Matt Zabriskie (https://github.com/mzabriskie)",
    "Jay (https://github.com/jasonsaayman)",
    "Dmitriy Mozgovoy (https://github.com/DigitalBrainJS)",
    "Nick Uraltsev (https://github.com/nickuraltsev)",
    "Emily Morehouse (https://github.com/emilyemorehouse)",
    "Rubén Norte (https://github.com/rubennorte)",
    "Justin Beckwith (https://github.com/JustinBeckwith)",
    "Martti Laine (https://github.com/codeclown)",
    "Xianming Zhong (https://github.com/chinesedfan)",
    "Shaan Majid (https://github.com/shaanmajid)",
    "Willian Agostini (https://github.com/WillianAgostini)",
    "Remco Haszing (https://github.com/remcohaszing)",
    "Rikki Gibson (https://github.com/RikkiGibson)"
  ],
  "sideEffects": false,
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/adrianbrowning/faxios/issues"
  },
  "homepage": "https://faxios-http.com",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "zshy",
    "bp": "pnpm build && pnpm pack",
    "version": "pnpm run build && git add package.json",
    "docs:dev": "cd docs && npm run docs:dev",
    "lint": "pnpm lint:ts; pnpm lint:fix",
    "lint:ts": "tsc --noEmit -p tsconfig.check.json",
    "lint:esl": "eslint --config eslint.config.ts \"**/*.{j,t}s{,x}\" --cache --cache-strategy content --max-warnings=0",
    "lint:s": "eslint --config eslint.config.style.ts \"**/*.{j,t}s{,x}\" --cache --cache-strategy content --max-warnings=0",
    "lint:fix": "pnpm lint:s --fix",
    "lint:e18e": "pnpm dlx @e18e/cli analyze"
  },
  "devDependencies": {
    "@gingacodemonkey/config": "^0.0.38",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "zshy": "latest"
  },
  "zshy": {
    "exports": {
      ".": "./src/index.ts",
      "./unsafe/core/buildFullPath.js": "./src/lib/core/buildFullPath.ts",
      "./unsafe/helpers/isAbsoluteURL.js": "./src/lib/helpers/isAbsoluteURL.ts",
      "./unsafe/helpers/buildURL.js": "./src/lib/helpers/buildURL.ts",
      "./unsafe/helpers/combineURLs.js": "./src/lib/helpers/combineURLs.ts",
      "./unsafe/utils.js": "./src/lib/utils.ts",
      "./package.json": "./package.json"
    },
    "cjs": false,
    "noEdit": false
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./unsafe/core/buildFullPath.js": {
      "types": "./dist/lib/core/buildFullPath.d.ts",
      "default": "./dist/lib/core/buildFullPath.js"
    },
    "./unsafe/helpers/isAbsoluteURL.js": {
      "types": "./dist/lib/helpers/isAbsoluteURL.d.ts",
      "default": "./dist/lib/helpers/isAbsoluteURL.js"
    },
    "./unsafe/helpers/buildURL.js": {
      "types": "./dist/lib/helpers/buildURL.d.ts",
      "default": "./dist/lib/helpers/buildURL.js"
    },
    "./unsafe/helpers/combineURLs.js": {
      "types": "./dist/lib/helpers/combineURLs.d.ts",
      "default": "./dist/lib/helpers/combineURLs.js"
    },
    "./unsafe/utils.js": {
      "types": "./dist/lib/utils.d.ts",
      "default": "./dist/lib/utils.js"
    },
    "./package.json": "./package.json"
  }
}
