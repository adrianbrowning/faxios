{
  "extends": "@gingacodemonkey/config/tsc/no-dom/library",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "./src",
    "incremental": false,
    "declarationMap": true,
    "types": [],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": ["./src/**/*.ts",
  "./eslint-rules/**/*.ts",
  "./eslint.config.style.ts",
  "./eslint.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
