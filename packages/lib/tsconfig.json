{
  "extends": "@gingacodemonkey/config/tsc/no-dom/library",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "./src",
    "incremental": false,
    "declarationMap": true,
    // No DOM lib and no @types/node: the build sees only the web globals web-globals.d.ts declares,
    // so a published declaration can't name a DOM-only or Node-only type (see src/lib/types/web.ts).
    "types": ["./src/lib/types/web-globals.d.ts"],
    "lib": ["ES2023"]
  },
  "include": [
    "./src/**/*.ts",
    "./eslint-rules/**/*.ts",
    "./eslint.config.style.ts",
    "./eslint.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
