{
  "extends": "@gingacodemonkey/config/tsc/no-dom/library",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "incremental": false,
    "typeRoots": [
      "../../node_modules/.pnpm/@types+node@25.9.3/node_modules/@types",
      "./node_modules/@types"
    ]
  },
  "include": [
    "eslint.config.ts",
    "eslint.config.style.ts",
    "./src/**/*.ts",
    "./tests/unit/**/*.ts",
    "./tests/setup/**/*.ts",
    "./tests/module/esm/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests/smoke",
    "tests/module/cjs"
  ]
}
