{
  "nodeModulesDir": "manual",
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19"
  },
  "tasks": {
    "install": "rm -rf .faxios && mkdir .faxios && tar -xzf ../../faxios.tgz --strip-components=1 -C .faxios && deno install --frozen",
    "test": "deno check types/ && deno test --allow-read --allow-env --allow-net=127.0.0.1 tests/"
  },
  "test": {
    "include": ["tests/**/*.smoke.test.ts"]
  },
  "lock": { "frozen": true }
}
