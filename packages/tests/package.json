{
  "name": "@faxios/tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "../lib/src/*"
  },
  "scripts": {
    "test": "vitest run",
    "test:vitest": "vitest run",
    "test:vitest:unit": "vitest run --project unit",
    "test:vitest:browser": "vitest run --project browser",
    "test:vitest:browser:headless": "vitest run --project browser-headless",
    "test:vitest:watch": "vitest",
    "test:smoke:esm:vitest": "npm --prefix smoke/esm run test:smoke:esm:vitest",
    "test:smoke:deno": "deno task --cwd smoke/deno test",
    "test:smoke:bun": "bun test --cwd smoke/bun",
    "test:module:esm": "npm --prefix module/esm run test:module:esm",
    "lint": "pnpm lint:ts && pnpm lint:esl && pnpm lint:s",
    "lint:ts": "tsc --noEmit -p tsconfig.check.json && tsc --noEmit -p browser/tsconfig.json && node scripts/check-ts-self-types.ts && node scripts/check-expect-error.ts && node scripts/check-license.ts && node scripts/check-skill-exports.ts && node scripts/check-workflow-timeouts.ts",
    "lint:ts:smoke": "tsc --noEmit -p smoke/esm/tsconfig.json && tsc --noEmit -p smoke/bun/tsconfig.json",
    "lint:esl": "eslint --config eslint.config.ts \"**/*.{j,t}s{,x}\" --cache --cache-strategy content --max-warnings=0",
    "lint:s": "eslint --config eslint.config.style.ts \"**/*.{j,t}s{,x}\" --cache --cache-strategy content --max-warnings=0",
    "lint:fix": "pnpm lint:s --fix",
    "test:docs-examples": "node docs-examples/extract.ts && tsc -p docs-examples/tsconfig.json && vitest run --config docs-examples/vitest.config.ts",
    "docs:sync": "cd ../.. && mdcode update --project --diff",
    "docs:sync:apply": "cd ../.. && mdcode update --project --apply",
    "docs:sync:check": "cd ../.. && mdcode update --project --check --quiet"
  },
  "devDependencies": {
    "@gcmdev/faxios": "workspace:*",
    "@gingacodemonkey/config": "^0.1.0",
    "@types/node": "^24.19.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "abortcontroller-polyfill": "^1.7.8",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "form-data": "^4.0.5",
    "mdcode-ts": "0.1.0",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  }
}
