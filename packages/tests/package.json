{
  "name": "@faxios/tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "../lib/src/*"
  },
  "scripts": {
    "test": "vitest run",
    "test:vitest": "vitest run",
    "test:vitest:unit": "vitest run --project unit",
    "test:vitest:typecheck": "vitest typecheck --project unit",
    "test:vitest:browser": "vitest run --project browser",
    "test:vitest:browser:headless": "vitest run --project browser-headless",
    "test:vitest:watch": "vitest",
    "test:smoke:esm:vitest": "npm --prefix smoke/esm run test:smoke:esm:vitest",
    "test:smoke:deno": "deno task --cwd smoke/deno test",
    "test:smoke:bun": "bun test --cwd smoke/bun",
    "test:module:esm": "npm --prefix module/esm run test:module:esm",
    "lint": "pnpm lint:ts; pnpm lint:fix",
    "lint:ts": "tsc --noEmit -p tsconfig.check.json && tsc --noEmit -p browser/tsconfig.json",
    "lint:esl": "eslint --config eslint.config.ts \"**/*.{j,t}s{,x}\" --cache --cache-strategy content --max-warnings=0",
    "lint:s": "eslint --config eslint.config.style.ts \"**/*.{j,t}s{,x}\" --cache --cache-strategy content --max-warnings=0",
    "lint:fix": "pnpm lint:s --fix"
  },
  "dependencies": {
    "faxios": "workspace:*"
  },
  "devDependencies": {
    "@gingacodemonkey/config": "^0.0.36",
    "@types/node": "^24.13.2",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "abortcontroller-polyfill": "^1.7.8",
    "eslint": "^9.39.4",
    "form-data": "^4.0.5",
    "formidable": "^3.5.4",
    "get-stream": "^9.0.1",
    "playwright": "^1.60.0",
    "selfsigned": "^5.5.0",
    "stream-throttle": "^0.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  }
}
