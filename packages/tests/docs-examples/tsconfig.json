{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Type-checks the blocks extract.ts writes to .generated/ against the built
  // @gcmdev/faxios package, the way a user's strict TypeScript project would.
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["node"],
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "typeRoots": ["../../../node_modules/@types", "../node_modules/@types"]
  },
  "include": [".generated/**/*.ts", ".generated/**/*.js"]
}
