{
  "name": "@faxios/docs",
  "version": "1.0.0",
  "description": "Documentation for the faxios HTTP client",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "docs:update:sponsors": "node ./scripts/process-sponsors.js",
    "prod:build": "npm run docs:update:sponsors && npm run docs:build",
    "postinstall": "patch-package --exclude nothing"
  },
  "dependencies": {
    "@gcmdev/faxios": "workspace:*",
    "@splidejs/splide": "4.1.4",
    "vitepress": "2.0.0-alpha.20"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "patch-package": "^8.0.1",
    "vue": "^3.5.43"
  }
}
