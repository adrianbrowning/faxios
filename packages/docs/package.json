{
  "name": "@faxios/docs",
  "version": "1.0.0",
  "description": "Documentation for the faxios HTTP client",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "lint": "pnpm lint:esl && pnpm lint:s",
    "lint:esl": "eslint --config eslint.config.ts \"**/*.{j,t}s{,x}\" --cache --max-warnings=0",
    "lint:s": "eslint --config eslint.config.style.ts \"**/*.{j,t}s{,x}\" --cache --max-warnings=0",
    "lint:fix": "pnpm lint:s --fix",
    "lint:ts": "tsc --noEmit -p ."
  },
  "dependencies": {
    "vitepress": "2.0.0-alpha.20"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vue": "^3.5.32"
  },
  "imports": {
    "#src/*.ts": "./src/*.ts"
  }
}
