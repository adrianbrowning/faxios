{
  "workspaces": {
    "packages/lib": {
      "project": ["**/*.{js,ts,cjs,mjs,mts}"]
    },
    "packages/tests": {
  "entry": [
        "**/*.{js,ts,cjs,mjs}"
  ],
      "project": ["**/*.{js,ts,cjs,mjs,mts}"],
      // @tanstack/query-core: imported only by the docs example blocks that
      // docs-examples/extract.ts writes to the git-ignored .generated/ directory.
      "ignoreDependencies": ["@gcmdev/faxios", "zod", "@tanstack/query-core"]
    },
    "packages/docs": {
      "project": ["**/*.{js,ts,mts,vue}"],
      "ignoreDependencies": ["esbuild"]
    },
    ".": {
      "entry": [".sandcastle/*.ts"],
      "project": ["**/*.{js,ts,cjs,mjs,mts}"]
    }
  },
  "ignoreBinaries": ["sha256sum", "uvx"],
  "ignoreDependencies": [
    "@vitest/browser",
    "@tanstack/intent",
    "zod"
  ],
  "ignoreExportsUsedInFile": true
}
