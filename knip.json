{
  "workspaces": {
    "packages/lib": {
      "entry": [
        "src/index.ts",
        "gulpfile.js",
        "webpack.config.js",
        "scripts/**/*.js",
        "tests/**/*.{js,ts,cjs,mjs}",
        "docs/**/*.{js,ts,mts}"
      ],
      "project": ["**/*.{js,ts,cjs,mjs,mts}"],
      "ignore": [
        "tests/module/**",
        "tests/smoke/**",
        "docs/**",
        "src/lib/platform/browser/**",
        "src/lib/platform/node/classes/**",
        "src/lib/env/classes/**",
        "src/lib/helpers/null.ts",
        "src/lib/helpers/deprecatedMethod.ts"
      ]
    },
    "packages/examples": {
      "entry": ["**/*.js"],
      "project": ["**/*.{js,ts}"],
      "ignoreDependencies": ["axios"]
    },
    "packages/sandbox": {
      "project": ["**/*.{js,ts}"],
      "ignore": ["client.js"]
    },
    ".": {
      "entry": [".sandcastle/*.ts"],
      "project": [".sandcastle/*.ts"],
      "ignore": [".sandcastle/worktrees/**"]
    }
  },
  "ignoreBinaries": ["playwright", "diff"],
  "ignoreDependencies": [
    "faxios",
    "prettier",
    "@babel/preset-env",
    "@vitest/browser"
  ],
  "ignoreExportsUsedInFile": true
}
