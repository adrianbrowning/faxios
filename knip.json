{
  "workspaces": {
    "packages/lib": {
      "entry": [
        "scripts/**/*.js"
      ],
      "project": ["**/*.{js,ts,cjs,mjs,mts}"],
      "ignore": [
        "src/lib/helpers/deprecatedMethod.ts"
      ]
    },
    "packages/tests": {
      "entry": [
        "**/*.{js,ts,cjs,mjs}"
      ],
      "project": ["**/*.{js,ts,cjs,mjs,mts}"],
      "ignoreDependencies": ["@gcmdev/faxios", "zod"]
    },
    "packages/docs": {
      "entry": [
        "scripts/**/*.js"
      ],
      "project": ["**/*.{js,ts,mts,vue}"],
      "ignoreDependencies": ["@splidejs/splide", "esbuild"]
    },
    "packages/examples": {
      "entry": ["**/*.js"],
      "project": ["**/*.{js,ts}"]
    },
    "packages/sandbox": {
      "project": ["**/*.{js,ts}"],
      "ignore": ["client.js"]
    },
    ".": {
      "entry": [],
      "project": []
    }
  },
  "ignoreBinaries": ["sha256sum"],
  "ignoreDependencies": [
    "@vitest/browser",
    "@ai-hero/sandcastle",
    "@tanstack/intent",
    "zod"
  ],
  "ignoreExportsUsedInFile": true
}
