{
  "workspaces": {
    "packages/lib": {
      "entry": [
        "gulpfile.js",
        "webpack.config.js",
        "scripts/**/*.js",
        "tests/**/*.{js,ts,cjs,mjs}",
        "docs/**/*.{js,ts,mts}"
      ],
      "project": ["**/*.{js,ts,cjs,mjs,mts}"],
      "ignore": ["tests/module/**", "tests/smoke/**", "docs/**"]
    },
    "packages/examples": {
      "entry": ["*.js"],
      "project": ["**/*.{js,ts}"],
      "ignoreDependencies": ["axios"]
    },
    "packages/sandbox": {
      "entry": ["server.js"],
      "project": ["**/*.{js,ts}"],
      "ignore": ["client.js"]
    }
  },
  "ignoreBinaries": ["playwright", "diff"],
  "ignoreDependencies": [
    "faxios",
    "prettier",
    "@babel/preset-env",
    "@vitest/browser"
  ]
}
